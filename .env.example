# Provider API keys (env values override ~/.milo/auth.json)
COMMANDCODE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gateway bot tokens
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=

# Web UI bearer token. Leave empty to mint a fresh one each run (the URL a
# restart prints will differ); set it to a stable secret so the URL survives.
MILO_WEB_TOKEN=

# Web search keys
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=

# Optional: override the Milo home directory (defaults to ~/.milo)
# MILO_HOME=
