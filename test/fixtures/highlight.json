  "highlight": [
    {
      "name": "ts: a const, a string and a trailing comment",
      "language": "ts",
      "code": "const total = 42 // counted",
      "runs": [
        {
          "role": "keyword",
          "text": "const"
        },
        {
          "role": "plain",
          "text": " total = "
        },
        {
          "role": "number",
          "text": "42"
        },
        {
          "role": "plain",
          "text": " "
        },
        {
          "role": "comment",
          "text": "// counted"
        }
      ]
    },
    {
      "name": "ts: an untagged fence takes the C-like rules",
      "language": null,
      "code": "let n = 0\nif (n) n += 1",
      "runs": [
        {
          "role": "keyword",
          "text": "let"
        },
        {
          "role": "plain",
          "text": " n = "
        },
        {
          "role": "number",
          "text": "0"
        },
        {
          "role": "plain",
          "text": "\n"
        },
        {
          "role": "keyword",
          "text": "if"
        },
        {
          "role": "plain",
          "text": " (n) n += "
        },
        {
          "role": "number",
          "text": "1"
        }
      ]
    },
