  "template": [
    {
      "name": "fills {id} from the current values",
      "text": "{seats} seats at $29 each",
      "values": { "seats": 8 },
      "expected": "8 seats at $29 each"
    },
    {
      "name": "leaves a reference to nothing alone",
      "text": "{nope} seats",
      "values": {},
      "expected": "{nope} seats"
    },
    {
      "name": "says a checkbox in words",
      "text": "extra: {extra}",
      "values": { "extra": true },
      "expected": "extra: true"
    },
    {
      "name": "fills a non-numeric value as it was written",
