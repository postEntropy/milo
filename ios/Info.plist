<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The daemon speaks plain http and ws. The encryption is the tailnet the
	     phone and the machine already share, so the app must be allowed to reach
	     it by address and by name alike — a tailnet address is neither the
	     loopback nor a private range iOS exempts on its own, and without this the
	     socket is refused before Milo ever sees the token. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>Milo</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array><string>AppIcon60x60</string></array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array><string>AppIcon60x60</string><string>AppIcon76x76</string></array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
	<!-- The system runs a background task only where its identifier is declared here, and
	     one of them is what keeps the phone on a running turn after the screen goes: about
	     half a minute without it. It must name the identifier `Support/ContinuedTurn.swift`
	     builds at run time, which is this app's own bundle id — `bundleID` in `xtool.yml` —
	     with a name of its own. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>dev.milo.app.reply</string>
	</array>
	<!-- Scanning the QR `milo pair` draws is how a phone is paired without typing
	     an address or a code, and the composer's attachment sheet can also take a
	     photo straight from the camera. -->
	<key>NSCameraUsageDescription</key>
	<string>Milo uses the camera to scan the pairing code from `milo pair` and to take photos to attach to a Session.</string>
	<!-- The attachment sheet shows a strip of recent photos from the library so one
	     can be added with a single tap. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Milo shows your recent photos so you can attach them to a Session.</string>
</dict>
</plist>
